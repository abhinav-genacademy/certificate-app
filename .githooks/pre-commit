#!/usr/bin/env bash
# Blocks a commit if gitleaks finds a likely secret in the staged diff.
# Enabled via the "prepare" npm script (git config core.hooksPath .githooks).
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "warning: gitleaks not installed — skipping secret scan for this commit." >&2
  echo "         install: https://github.com/gitleaks/gitleaks#installing" >&2
  exit 0
fi

gitleaks protect --staged --redact --verbose
