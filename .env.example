# Postgres connection string (Neon, or any Postgres — including a local one
# for dev, e.g. via Docker). Run db/schema.sql against it once before first
# use: psql "$DATABASE_URL" -f db/schema.sql
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin sign-in credentials (single admin account, no user database).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# The admin area is hidden behind this path instead of the guessable "/admin" —
# pick something private and non-obvious, e.g. a random slug. Only people who
# know this URL can even see the admin login form; anyone else hitting
# /admin directly gets a normal 404. Leave unset to fall back to plain "/admin"
# (no hiding).
ADMIN_PATH="change-me-to-something-private"

# Random secret used to sign the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-too"

# Public URL this app is deployed at (no trailing slash). Used to build
# QR codes and shareable /verify links baked into each certificate.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional. Bearer token for the Google Forms integration (a separate
# project, ../google-forms-certificate-addon) to add a completed student +
# generate their certificate. Scoped to just that action, separate from
# admin login. Leave unset if you're not using that integration.
AUTOMATION_API_KEY=""
